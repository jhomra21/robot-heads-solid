{
  "name": "robot-heads-solid",
  "version": "0.1.0-beta.3",
  "description": "Animated TV-headed robot avatars for Solid, drawn with Canvas 2D.",
  "keywords": [
    "solid",
    "solidjs",
    "robot",
    "avatar",
    "agent",
    "animation",
    "canvas",
    "3d",
    "led"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhomra21/robot-heads-solid.git"
  },
  "homepage": "https://github.com/jhomra21/robot-heads-solid#readme",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.cjs"
        }
      },
      "node": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.server.js"
        },
        "require": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.server.cjs"
        }
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "workspaces": [
    "site"
  ],
  "scripts": {
    "dev": "cd site && bun run dev",
    "build": "vite build && vite build --config vite.ssr.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "build:site": "bun run build && cd site && bun run build",
    "check": "bun run lint && bun run typecheck && bun run build && cd site && bun run typecheck && bun run build",
    "deploy": "bun run build:site && cd site && bun run deploy",
    "prepublishOnly": "bun run check",
    "e2e": "playwright test",
    "e2e:consumer": "bun run build && bun pm pack --filename test-results/robot-heads-solid-beta.3.tgz && cd e2e/consumer && bun install --force && bun run typecheck && bun run build && node ssr.mjs && cd ../.. && bunx playwright test --config playwright.consumer.config.ts"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "solid-js": "^1.9.15",
    "vite": "^8.3.0",
    "vite-plugin-solid": "^2.11.14",
    "vite-plugin-dts": "^4.5.0",
    "typescript": "^5.9.3",
    "@playwright/test": "^1.56.0",
    "oxlint": "1.87.0",
    "@oxlint/plugins": "1.87.0"
  }
}
